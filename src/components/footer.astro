---
// src/components/Footer.astro
import Default from '@astrojs/starlight/components/Footer.astro';
---
<div class="bmc-container">
  <a href="https://buymeacoffee.com/meixxi" target="_blank" rel="noopener">
    <img src="/bmc-button.svg" alt="Buy me a coffee" width="235" height="50" />
  </a>
</div>
<Default {...Astro.props}><slot /></Default>
<div class="legal-footer">
  <a href="https://meixxi.github.io/" target="_blank" rel="noopener">Dr. Stefan Meissner</a>
  <span class="legal-sep">·</span>
  <a href="https://creativecommons.org/licenses/by/4.0/" target="_blank" rel="noopener license">CC BY 4.0</a>
  <span class="legal-sep">·</span>
  <a href="https://meixxi.github.io/imprint/" target="_blank" rel="noopener">Imprint &amp; Privacy</a>
</div>

<style>
  .bmc-container {
    padding-bottom: 1rem;
    display: flex;
    justify-content: center;
  }

  .legal-footer {
    margin-top: 0.75rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--sl-color-gray-6);
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-3);
  }

  .legal-footer a {
    color: var(--sl-color-gray-3);
    text-decoration: none;
    transition: color 150ms ease;
  }

  .legal-footer a:is(:hover, :focus-visible) {
    color: var(--sl-color-white);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .legal-sep {
    opacity: 0.6;
  }
</style>
